{
  "name": "bubblesort",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A daily browser game: order five GitHub repos by a stat.",
  "scripts": {
    "fetch": "node tools/fetch-repos.ts",
    "dataset": "node tools/build-dataset.ts",
    "calendar": "node --env-file=.env.calendar.local tools/build-calendar.ts",
    "sim": "node tools/sim.ts",
    "verify": "node tools/verify.ts",
    "verify:fixture": "node tools/verify-fixture.ts",
    "verify:build": "node tools/verify-build.ts",
    "verify:client": "playwright test",
    "verify:public": "npm run verify:fixture && npm run verify:build && npm run verify:client",
    "check:deploy": "node tools/check-deploy.ts",
    "deploy": "npm run check:deploy && lakebed deploy",
    "dev": "lakebed dev --port 3000"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "lakebed": "0.0.40"
  },
  "engines": {
    "node": ">=23.6"
  }
}
